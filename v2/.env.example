# Free CoinGecko Demo API key — https://www.coingecko.com/en/api/pricing (Demo plan)
# Optional in dev, recommended. Copy this file to .env.local and fill in.
VITE_COINGECKO_DEMO_KEY=

# Bump to invalidate the entire persisted IndexedDB query cache (e.g. on a type/key-shape change).
VITE_CACHE_VERSION=1
